m1: modulator, type = "lineart", T0 = -0.51*s, T1 = 0.51*s, amplitudeScale = 2.0, amplitudeOffset = 2.0;
f1: field, type = "bmap2d", magneticFile = "bdsim2d:b-field.dat.gz", fieldModulator = "m1";
d1: drift, l = 1.0*m, aper1 = 1.0*m, fieldAll = "f1";

l1: line = (d1);
use, l1;

beam, particle = "proton",
	momentum = 50.0*GeV,
	distrType = "userfile",
	distrFile = "beam_linear_modulator.dat.gz",
	distrFileFormat = "z[m]:t[s]";

sample, all;