d1: drift, l=2*m;
c1: rcol, l=0.1*m, xsize=0*m, ysize=0*m, material="G4_Fe";
d2: drift, l=2*m;

l0 : line = (d1,c1,d2);

use, period=l0;

sample, all;

s1: samplerplacement, referenceElement="d2",
                      referenceElementNumber=0,
                      x=30*cm, y=0*cm, s=(30-100)*cm,
                      axisAngle=1, axisY=1, angle=pi/4,
                      aper1=10*cm;

beam, particle="e-",
      energy=1*GeV,
      X0=0.0*m,
      Xp0=0.0,
      Y0=0.0*m,
      Yp0=0.0,
      alfx=0,
      alfy=0,
      betx=4*m,
      bety=4*m,
      dispx=0.0*m,
      dispxp=0.0,
      dispy=0.0*m,
      dispyp=0.0,
      distrType="gausstwiss",
      emitx=5e-7*m,
      emity=5e-7*m,
      sigmaE=0.02,
      sigmaT=1e-11;

option, physicsList="em";