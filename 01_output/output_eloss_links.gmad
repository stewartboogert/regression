d1: drift, l=2*m;
c1: jcol, l=0.1*m, xsize=1*cm, ysize=0*m, material="G4_Fe";
d2: drift, l=2*m;

l0 : line = (d1,c1,d2);

use, period=l0;

sample, all;

beam, particle="e-",
      energy=1*GeV,
      X0=1.5*cm,
      Xp0=0.0,
      Y0=0.0*m,
      Yp0=0.0,
      alfx=0,
      alfy=0,
      betx=4*m,
      bety=4*m,
      dispx=0.0*m,
      dispxp=0.0,
      dispy=0.0*m,
      dispyp=0.0,
      distrType="gausstwiss",
      emitx=5e-7*m,
      emity=5e-7*m,
      sigmaE=0.02,
      sigmaT=1e-11;

option, physicsList="em",
	storeElossLinks=1;